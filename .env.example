# MarketPulse environment — copy to .env.local and fill in.
# Everything works with ZERO keys (deterministic template + keyless data);
# a Gemini key upgrades the AI explanations and chat to real LLM answers.

# Get a free key at https://aistudio.google.com — paste it in .env.local
GEMINI_API_KEY=

# Optional: model fallback chain (free-tier quota is PER MODEL — 20 req/min
# each). When the first model's bucket drains, the app tries the next one.
# GEMINI_MODEL_CHAIN=gemini-3.6-flash,gemini-3.5-flash

# Optional: PRISM trace export
PRISMTRACE_API_KEY=
