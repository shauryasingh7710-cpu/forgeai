# ── MarketPulse configuration ────────────────────────────────────────────────
# Everything below is OPTIONAL. The app runs fully without any keys:
#  • AI explanations fall back to a deterministic grounded template
#  • PRISM sessions buffer locally with identical schema

# Gemini API key for LLM narratives (free tier: https://aistudio.google.com)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# PRISM by BlockConvey — official trace API (https://blockconvey.com/docs)
# 1. Sign up at https://prism.blockconvey.com/signup (creates org + project)
# 2. Copy the Project ID from Settings → Project
# 3. Create an API key (scope: ingest) on the API keys page — shown once!
# Free plan: 25,000 traces/month, automatic scoring included, no credits needed.
# PRISMTRACE_HOST=https://prism.blockconvey.com
# PRISMTRACE_PROJECT_ID=00000000-0000-0000-0000-000000000000
# PRISMTRACE_API_KEY=pt-sk-...
